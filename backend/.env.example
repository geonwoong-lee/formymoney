VERY_RICH_APP_NAME=Very Rich?
VERY_RICH_API_V1_PREFIX=/api/v1
# Supabase Dashboard > Connect > Session pooler에서 복사합니다.
# SQLAlchemy가 psycopg를 사용하도록 postgresql+psycopg:// 로 시작하고,
# Session pooler 포트 5432와 sslmode=require를 사용합니다.
# 비밀번호의 @, :, /, ?, # 같은 예약 문자는 URL 인코딩해야 합니다.
VERY_RICH_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connect_timeout=10
VERY_RICH_FRONTEND_ORIGINS=http://localhost:5173
# Supabase Auth API 연결에 사용합니다. Dashboard의 Project URL과 공개용 anon key를 입력합니다.
VERY_RICH_SUPABASE_URL=
VERY_RICH_SUPABASE_ANON_KEY=

# Phase 12부터 n8n이 FastAPI 내부 브리핑 API를 호출할 때 사용할 비밀값입니다.
# 충분히 긴 임의 문자열을 backend/.env와 n8n Credential에 각각 같은 값으로 넣습니다.
VERY_RICH_N8N_INGEST_SECRET=
