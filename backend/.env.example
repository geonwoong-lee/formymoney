VERY_RICH_APP_NAME=Very Rich?
VERY_RICH_API_V1_PREFIX=/api/v1
# Supabase Dashboard > Connect > Session pooler에서 복사합니다.
# SQLAlchemy가 psycopg를 사용하도록 postgresql+psycopg:// 로 시작하고,
# Session pooler 포트 5432와 sslmode=require를 사용합니다.
# 비밀번호의 @, :, /, ?, # 같은 예약 문자는 URL 인코딩해야 합니다.
VERY_RICH_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connect_timeout=10
VERY_RICH_FRONTEND_ORIGINS=http://localhost:5173
# Supabase Auth API 연결에 사용합니다. Dashboard의 Project URL과 공개용 anon key를 입력합니다.
VERY_RICH_SUPABASE_URL=
VERY_RICH_SUPABASE_ANON_KEY=

# Phase 12부터 n8n이 FastAPI 내부 브리핑 API를 호출할 때 사용할 비밀값입니다.
# 충분히 긴 임의 문자열을 backend/.env와 n8n Credential에 각각 같은 값으로 넣습니다.
VERY_RICH_N8N_INGEST_SECRET=

# 네이버 뉴스 검색 API 키(헤드라인 수집용). API 허브 키가 있으면 허브를, 없으면 개발자센터 키를 사용합니다.
VERY_RICH_NAVER_HUB_KEY_ID=
VERY_RICH_NAVER_HUB_KEY=
VERY_RICH_NAVER_CLIENT_ID=
VERY_RICH_NAVER_CLIENT_SECRET=

# 해외 헤드라인 한국어 해석에 사용합니다. 모델은 VERY_RICH_OPENAI_MODEL로 바꿀 수 있습니다(기본 gpt-5.6-luna).
VERY_RICH_OPENAI_API_KEY=

# 한국은행 경제통계시스템(ECOS) 인증키. 시장 탭의 환율·증시·금리 수집에 사용합니다(https://ecos.bok.or.kr/api).
VERY_RICH_ECOS_API_KEY=
# 금융감독원 금융상품 한눈에 Open API 인증키(32자리). 예·적금 공시 금리 변동 수집에 사용합니다(https://finlife.fss.or.kr).
VERY_RICH_FINLIFE_API_KEY=
VERY_RICH_YOUTH_API_KEY=
# 금융감독원 전자공시(OpenDART) 인증키. 은행 재무제표 주요 계정과 은행·금융지주 공시 목록에 사용합니다(https://opendart.fss.or.kr).
VERY_RICH_DART_API_KEY=

# n8n 수집이 하루에 쓸 수 있는 OpenAI 토큰(입력+출력) 상한. 초과하면 실행 상태 API가 알려줍니다.
VERY_RICH_DAILY_TOKEN_LIMIT=200000
