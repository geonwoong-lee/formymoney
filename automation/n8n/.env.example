# n8n이 저장한 Credential을 암호화하는 충분히 긴 임의 문자열입니다.
N8N_ENCRYPTION_KEY=

# backend/.env의 VERY_RICH_N8N_INGEST_SECRET과 같은 값을 넣습니다.
VERY_RICH_N8N_INGEST_SECRET=

# Docker에서 호스트 FastAPI를 호출하는 기본 주소입니다. 포트를 바꾼 경우에만 수정합니다.
VERY_RICH_API_BASE_URL=http://host.docker.internal:8000

# 짧은 구조화 요약에 사용할 모델입니다. API 키는 이 파일이 아니라 n8n Credential에 등록합니다.
OPENAI_MODEL=gpt-5.6-luna
